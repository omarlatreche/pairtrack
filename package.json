{
  "name": "pairtrack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first, encrypted job-pack tracker for Openreach frame work. No backend, no network, no account.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "git config core.hooksPath .githooks",
    "postinstall": "node scripts/install-hooks.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs dist && npm run check:origins",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:data": "node scripts/no-data-scan.mjs",
    "check:origins": "node scripts/check-no-external-origins.mjs dist",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:data",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "preact": "^10.27.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.37.0",
    "fake-indexeddb": "^6.2.2",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
